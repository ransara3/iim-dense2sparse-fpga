set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7N
set_global_assignment -name TOP_LEVEL_ENTITY de2_115_board_top
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/uart_8n1.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/margin_gated_ccl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/de2_115_uart_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/de2_115_board_top.sv
set_global_assignment -name SDC_FILE de2_115_uart.sdc

set_location_assignment PIN_Y2 -to CLOCK_50
set_location_assignment PIN_M23 -to KEY[0]
set_location_assignment PIN_C25 -to UART_RXD
set_location_assignment PIN_B25 -to UART_TXD

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_RXD
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_TXD
